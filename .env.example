PUMPFUN_SOURCE=pumpportal
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_ENDPOINT=
SOLANA_LOGS_MENTIONS_ADDRESS=
WATCH_WALLET_ADDRESS=
DATABASE_PATH=data/cryptoarc.db
LIVE_TRADING_ENABLED=false
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_MIN_INTERVAL_SECONDS=60
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DASHBOARD_PASSWORD=
DASHBOARD_TOTP_SECRET=
MOBILE_PUBLIC_API_BASE_URL=
MOBILE_PAIRING_TTL_SECONDS=300
MOBILE_TOKEN_TTL_DAYS=30
MOBILE_EXPO_PUSH_ENABLED=false
MOBILE_EXPO_PUSH_TIMEOUT_SECONDS=10
MOBILE_PUSH_TOKEN_ENCRYPTION_KEY=
GRADING_MODEL_ENABLED=false
GRADING_MODEL_DAILY_TOKEN_BUDGET=100000
GRADING_MODEL_DAILY_COST_BUDGET=10
GRADING_MODEL_MAX_ITEMS=8
GRADING_MODEL_TIMEOUT_SECONDS=10
GRADING_MODEL_RETRY_LIMIT=1
# Deployment notes:
# - Set DASHBOARD_PASSWORD before exposing the dashboard on a network.
# - Set DASHBOARD_TOTP_SECRET to enable authenticator-app 2FA.
# - Set MOBILE_PUBLIC_API_BASE_URL to the Tailscale-only backend URL shown in mobile pairing QR payloads.
# - Do not expose mobile pairing through Tailscale Funnel or the public internet.
# - Keep LIVE_TRADING_ENABLED=false until a reviewed live executor exists.
# - Keep TELEGRAM_BOT_TOKEN only in local .env secrets, never in repo docs or exports.
# - Keep GRADING_MODEL_ENABLED=false unless a reviewed, injected classifier client is configured for narrative-only grades.
